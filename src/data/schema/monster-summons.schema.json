{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "d2h5://schema/monster-summons",
  "description": "Generic monster minion body and startup summon cap. Fixed body stats do not scale with owner Attack or level; magical mitigation retains its existing owner.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "summonAdds",
    "templates"
  ],
  "properties": {
    "id": {
      "const": "summons/monster"
    },
    "templates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minion"
      ],
      "properties": {
        "minion": {
          "$ref": "#/$defs/bodyStats"
        }
      }
    },
    "summonAdds": {
      "type": "object",
      "additionalProperties": false,
      "description": "Startup template action tuning; one birth per eligible cast, with replacement up to a living cap.",
      "required": [
        "maxCount",
        "onStart"
      ],
      "properties": {
        "maxCount": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum living minions for one owner."
        },
        "onStart": {
          "type": "boolean",
          "description": "Attempt the normal eligible cast once during battle startup."
        }
      }
    }
  },
  "$defs": {
    "bodyStats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lifeMax",
        "manaMax",
        "attack",
        "defense",
        "attackSpeed",
        "critChance",
        "critDamage",
        "physDodge",
        "magicDodge",
        "magicFind",
        "goldFind",
        "resistances"
      ],
      "properties": {
        "lifeMax": {
          "type": "integer",
          "minimum": 1
        },
        "manaMax": {
          "type": "integer",
          "minimum": 0
        },
        "attack": {
          "type": "integer",
          "minimum": 0
        },
        "defense": {
          "type": "integer",
          "minimum": 0
        },
        "attackSpeed": {
          "type": "integer",
          "minimum": 0
        },
        "critChance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "critDamage": {
          "type": "number",
          "minimum": 1
        },
        "physDodge": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "magicDodge": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "magicFind": {
          "type": "number",
          "minimum": 0
        },
        "goldFind": {
          "type": "number",
          "minimum": 0
        },
        "resistances": {
          "$ref": "#/$defs/resistances"
        }
      }
    },
    "resistances": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "physical",
        "fire",
        "cold",
        "lightning",
        "poison",
        "arcane"
      ],
      "properties": {
        "physical": {
          "type": "number",
          "minimum": -100,
          "maximum": 100
        },
        "fire": {
          "type": "number",
          "minimum": -100,
          "maximum": 100
        },
        "cold": {
          "type": "number",
          "minimum": -100,
          "maximum": 100
        },
        "lightning": {
          "type": "number",
          "minimum": -100,
          "maximum": 100
        },
        "poison": {
          "type": "number",
          "minimum": -100,
          "maximum": 100
        },
        "arcane": {
          "type": "number",
          "minimum": -100,
          "maximum": 100
        }
      }
    }
  }
}
