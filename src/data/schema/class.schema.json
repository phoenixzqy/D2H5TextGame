{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://d2h5.game/schemas/class.json",
  "title": "Class Definition",
  "description": "Developer-editable character class tuning definition",
  "type": "object",
  "required": ["id", "name", "startingStats", "statGrowth", "lifePerLevel", "manaPerLevel", "starterSkills"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^classes/[a-z0-9-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "startingStats": { "$ref": "#/$defs/coreStats" },
    "statGrowth": { "$ref": "#/$defs/coreStats" },
    "lifePerLevel": {
      "type": "number",
      "minimum": 0
    },
    "manaPerLevel": {
      "type": "number",
      "minimum": 0
    },
    "starterWeapon": {
      "description": "Optional deterministic weapon recipe prepared for a new level-1 character; omission means no weapon.",
      "type": "object",
      "required": ["baseId", "baseRolls"],
      "additionalProperties": false,
      "properties": {
        "baseId": {
          "description": "Reference to an existing level-1 weapon base.",
          "type": "string",
          "pattern": "^items/base/[a-z0-9-]+$"
        },
        "baseRolls": {
          "description": "Persisted attack roll, checked against the referenced base's inclusive damage range.",
          "type": "object",
          "required": ["attack"],
          "additionalProperties": false,
          "properties": {
            "attack": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "starterSkills": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    }
  },
  "$defs": {
    "coreStats": {
      "type": "object",
      "required": ["strength", "dexterity", "vitality", "energy"],
      "additionalProperties": false,
      "properties": {
        "strength": { "type": "number", "minimum": 0 },
        "dexterity": { "type": "number", "minimum": 0 },
        "vitality": { "type": "number", "minimum": 0 },
        "energy": { "type": "number", "minimum": 0 }
      }
    }
  }
}
