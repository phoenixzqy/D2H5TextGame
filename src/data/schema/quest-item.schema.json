{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://d2h5.game/schemas/quest-item.json",
  "title": "Bound quest item definitions",
  "description": "Capacity-independent, source-bound quest items and their authored Read effects.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional authoring schema reference."
    },
    "items": {
      "type": "array",
      "description": "Unique item and source quest pairs; cross-references are checked by the loader.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sourceQuestId",
          "nameKey",
          "descKey"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(quest|items)/[a-z0-9][a-z0-9._-]*$",
            "description": "Quest item definition identity; this does not identify equippable gear."
          },
          "sourceQuestId": {
            "type": "string",
            "pattern": "^quests/[a-z0-9][a-z0-9._-]*$",
            "description": "Quest containing the issuing reward or explicitly named fetch objective."
          },
          "nameKey": {
            "type": "string",
            "minLength": 1,
            "description": "Localized item name key."
          },
          "descKey": {
            "type": "string",
            "minLength": 1,
            "description": "Localized effect description key."
          },
          "effect": {
            "type": "object",
            "description": "Read effect, applied once when the entitlement is consumed.",
            "additionalProperties": false,
            "properties": {
              "skillPoints": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991,
                "description": "Authored positive safe-integer unspent skill points granted by Read."
              },
              "maxLife": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991,
                "description": "Permanent maximum Life granted by actual once-only Read; does not heal."
              }
            },
            "oneOf": [
              {
                "required": [
                  "skillPoints"
                ],
                "properties": {
                  "skillPoints": {}
                }
              },
              {
                "required": [
                  "maxLife"
                ],
                "properties": {
                  "maxLife": {}
                }
              }
            ],
            "maxProperties": 1
          },
          "kind": {
            "enum": [
              "tool",
              "component",
              "assembled",
              "delivery"
            ],
            "description": "Objective-sourced retained tool, recipe ingredient, or assembled quest key."
          },
          "sourceObjectiveId": {
            "type": "string",
            "minLength": 1,
            "description": "Exact issuing fetch or transmute objective; together with sourceQuestId forms the unique source."
          },
          "consumedBy": {
            "type": "string",
            "pattern": "^(quest|items)/[a-z0-9][a-z0-9._-]*$",
            "description": "Exact assembled output item that consumes this component."
          },
          "recipe": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "requiredTool": {
            "type": "string",
            "pattern": "^(quest|items)/[a-z0-9][a-z0-9._-]*$",
            "description": "Retained tool required by this recipe."
          },
          "ingredients": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(quest|items)/[a-z0-9][a-z0-9._-]*$"
            }
          },
          "consumeQuestId": {
            "type": "string",
            "pattern": "^quests/[a-z0-9][a-z0-9._-]*$"
          },
          "consumeObjectiveId": {
            "type": "string",
            "minLength": 1
          },
          "outputItemId": {
            "type": "string",
            "pattern": "^(quest|items)/[a-z0-9][a-z0-9._-]*$",
            "description": "Optional real delivery output created by this exact hand-in; reciprocal source graph is loader-validated."
          }
        },
        "oneOf": [
          {
            "required": [
              "effect"
            ],
            "properties": {
              "effect": {},
              "kind": false,
              "sourceObjectiveId": false,
              "consumedBy": false,
              "recipe": false,
              "requiredTool": false,
              "ingredients": false,
              "consumeQuestId": false,
              "consumeObjectiveId": false,
              "outputItemId": false
            }
          },
          {
            "required": [
              "kind",
              "sourceObjectiveId"
            ],
            "properties": {
              "kind": {
                "const": "tool"
              },
              "effect": false,
              "consumedBy": false,
              "recipe": false,
              "requiredTool": false,
              "ingredients": false,
              "consumeQuestId": false,
              "consumeObjectiveId": false,
              "outputItemId": false
            }
          },
          {
            "required": [
              "kind",
              "sourceObjectiveId",
              "consumedBy"
            ],
            "properties": {
              "kind": {
                "const": "component"
              },
              "effect": false,
              "recipe": false,
              "requiredTool": false,
              "ingredients": false,
              "consumeQuestId": false,
              "consumeObjectiveId": false,
              "outputItemId": false
            }
          },
          {
            "required": [
              "kind",
              "sourceObjectiveId",
              "recipe",
              "requiredTool",
              "ingredients",
              "consumeQuestId",
              "consumeObjectiveId"
            ],
            "properties": {
              "kind": {
                "const": "assembled"
              },
              "effect": false,
              "consumedBy": false,
              "outputItemId": false
            }
          },
          {
            "required": [
              "kind",
              "sourceObjectiveId",
              "consumeObjectiveId"
            ],
            "properties": {
              "kind": {
                "const": "delivery"
              },
              "effect": false,
              "consumedBy": false,
              "recipe": false,
              "requiredTool": false,
              "ingredients": false,
              "consumeQuestId": false
            }
          }
        ]
      }
    }
  }
}
