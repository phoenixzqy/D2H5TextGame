{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://d2h5.game/schemas/quest-item.json",
  "title": "Bound quest item definitions",
  "description": "Capacity-independent, source-bound quest items, retained rewards and authored Read effects.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "items"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Optional authoring schema reference."
    },
    "items": {
      "type": "array",
      "description": "Unique item and source quest pairs; cross-references are checked by the loader.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sourceQuestId",
          "nameKey",
          "descKey"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(quest|items)/[a-z0-9][a-z0-9._-]*$",
            "description": "Quest item definition identity; this does not identify equippable gear."
          },
          "sourceQuestId": {
            "type": "string",
            "pattern": "^quests/[a-z0-9][a-z0-9._-]*$",
            "description": "Quest containing the issuing reward or explicitly named fetch objective."
          },
          "nameKey": {
            "type": "string",
            "minLength": 1,
            "description": "Localized item name key."
          },
          "descKey": {
            "type": "string",
            "minLength": 1,
            "description": "Localized effect description key."
          },
          "effect": {
            "type": "object",
            "description": "Read effect, applied once when the entitlement is consumed.",
            "additionalProperties": false,
            "properties": {
              "skillPoints": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991,
                "description": "Authored positive safe-integer unspent skill points granted by Read."
              },
              "maxLife": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991,
                "description": "Permanent maximum Life granted by actual once-only Read; does not heal."
              },
              "allResist": {
                "const": 10
              }
            },
            "oneOf": [
              {
                "required": [
                  "skillPoints"
                ],
                "properties": {
                  "skillPoints": {}
                }
              },
              {
                "required": [
                  "maxLife"
                ],
                "properties": {
                  "maxLife": {}
                }
              },
              {
                "required": [
                  "allResist"
                ],
                "properties": {
                  "allResist": {}
                }
              }
            ],
            "maxProperties": 1
          },
          "kind": {
            "enum": [
              "tool",
              "component",
              "assembled",
              "delivery",
              "retained",
              "encounter",
              "action"
            ],
            "description": "Objective-sourced retained tool, recipe ingredient, or assembled quest key."
          },
          "sourceObjectiveId": {
            "type": "string",
            "minLength": 1,
            "description": "Exact issuing fetch or transmute objective; together with sourceQuestId forms the unique source."
          },
          "consumedBy": {
            "type": "string",
            "pattern": "^(quest|items)/[a-z0-9][a-z0-9._-]*$",
            "description": "Exact assembled output item that consumes this component."
          },
          "requiresAreaClear": {
            "const": true,
            "description": "Explicit recovery additionally requires the source area's full clear."
          },
          "requiredActionSource": {
            "enum": [
              "quests/act3-khalims-will#action:council-victory",
              "quests/act3-guardian#action:break-compelling-orb",
              "quests/act4-hellforge#action:hephasto-victory"
            ],
            "description": "Exact finite action proof required by its closed item variant."
          },
          "recipe": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "requiredTool": {
            "type": "string",
            "pattern": "^(quest|items)/[a-z0-9][a-z0-9._-]*$",
            "description": "Retained tool required by this recipe."
          },
          "ingredients": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(quest|items)/[a-z0-9][a-z0-9._-]*$"
            }
          },
          "consumeQuestId": {
            "type": "string",
            "pattern": "^quests/[a-z0-9][a-z0-9._-]*$"
          },
          "consumeObjectiveId": {
            "type": "string",
            "minLength": 1
          },
          "consumeActionId": {
            "enum": [
              "actions/act3-break-compelling-orb",
              "actions/act4-shatter-soulstone",
              "actions/act5-thaw-anya"
            ]
          },
          "outputItemId": {
            "type": "string",
            "pattern": "^(quest|items)/[a-z0-9][a-z0-9._-]*$",
            "description": "Optional real delivery output created by this exact hand-in; reciprocal source graph is loader-validated."
          },
          "targetId": {
            "const": "objects/hellforge_hammer_cache"
          },
          "sourceActionId": {
            "const": "actions/act5-receive-malah-potion"
          }
        },
        "oneOf": [
          {
            "required": [
              "effect"
            ],
            "properties": {
              "effect": {},
              "kind": false,
              "sourceObjectiveId": false,
              "consumedBy": false,
              "recipe": false,
              "requiredTool": false,
              "ingredients": false,
              "consumeQuestId": false,
              "consumeObjectiveId": false,
              "consumeActionId": false,
              "requiresAreaClear": false,
              "requiredActionSource": false,
              "outputItemId": false,
              "targetId": false,
              "sourceActionId": false
            }
          },
          {
            "required": [
              "kind",
              "sourceObjectiveId"
            ],
            "properties": {
              "kind": {
                "const": "tool"
              },
              "effect": false,
              "consumedBy": false,
              "recipe": false,
              "requiredTool": false,
              "ingredients": false,
              "consumeQuestId": false,
              "consumeObjectiveId": false,
              "consumeActionId": false,
              "requiresAreaClear": false,
              "requiredActionSource": false,
              "outputItemId": false,
              "targetId": false,
              "sourceActionId": false
            }
          },
          {
            "required": [
              "kind",
              "sourceObjectiveId",
              "consumedBy"
            ],
            "properties": {
              "kind": {
                "const": "component"
              },
              "requiredActionSource": {
                "const": "quests/act3-khalims-will#action:council-victory"
              },
              "effect": false,
              "recipe": false,
              "requiredTool": false,
              "ingredients": false,
              "consumeQuestId": false,
              "consumeObjectiveId": false,
              "consumeActionId": false,
              "outputItemId": false,
              "targetId": false,
              "sourceActionId": false
            }
          },
          {
            "required": [
              "kind",
              "sourceObjectiveId",
              "recipe",
              "requiredTool",
              "ingredients",
              "consumeQuestId"
            ],
            "properties": {
              "kind": {
                "const": "assembled"
              },
              "effect": false,
              "consumedBy": false,
              "requiresAreaClear": false,
              "requiredActionSource": false,
              "outputItemId": false,
              "targetId": false,
              "consumeActionId": {
                "const": "actions/act3-break-compelling-orb"
              },
              "sourceActionId": false
            },
            "oneOf": [
              {
                "required": [
                  "consumeObjectiveId"
                ],
                "properties": {
                  "consumeObjectiveId": {},
                  "consumeActionId": false
                }
              },
              {
                "required": [
                  "consumeActionId"
                ],
                "properties": {
                  "consumeActionId": {},
                  "consumeObjectiveId": false
                }
              }
            ]
          },
          {
            "required": [
              "kind",
              "requiredActionSource",
              "consumeActionId"
            ],
            "properties": {
              "kind": {
                "const": "retained"
              },
              "requiredActionSource": {
                "const": "quests/act3-guardian#action:break-compelling-orb"
              },
              "effect": false,
              "sourceObjectiveId": false,
              "consumedBy": false,
              "recipe": false,
              "requiredTool": false,
              "ingredients": false,
              "consumeQuestId": false,
              "consumeObjectiveId": false,
              "consumeActionId": {
                "const": "actions/act4-shatter-soulstone"
              },
              "requiresAreaClear": false,
              "outputItemId": false,
              "targetId": false,
              "sourceActionId": false
            }
          },
          {
            "required": [
              "kind",
              "sourceObjectiveId",
              "consumeObjectiveId"
            ],
            "properties": {
              "kind": {
                "const": "delivery"
              },
              "effect": false,
              "consumedBy": false,
              "recipe": false,
              "requiredTool": false,
              "ingredients": false,
              "consumeQuestId": false,
              "consumeActionId": false,
              "requiresAreaClear": false,
              "requiredActionSource": false,
              "targetId": false,
              "sourceActionId": false
            }
          },
          {
            "required": [
              "id",
              "kind",
              "sourceQuestId",
              "sourceObjectiveId",
              "nameKey",
              "descKey",
              "targetId",
              "requiredActionSource",
              "consumeActionId"
            ],
            "properties": {
              "effect": false,
              "consumedBy": false,
              "requiresAreaClear": false,
              "recipe": false,
              "requiredTool": false,
              "ingredients": false,
              "consumeQuestId": false,
              "consumeObjectiveId": false,
              "outputItemId": false,
              "id": {
                "const": "quest/hellforge_hammer"
              },
              "kind": {
                "const": "encounter"
              },
              "sourceQuestId": {
                "const": "quests/act4-hellforge"
              },
              "sourceObjectiveId": {
                "const": "obj-kill-hephasto"
              },
              "nameKey": {
                "const": "inventory:questItems.hellforgeHammer.name"
              },
              "descKey": {
                "const": "inventory:questItems.hellforgeHammer.desc"
              },
              "targetId": {
                "const": "objects/hellforge_hammer_cache"
              },
              "requiredActionSource": {
                "const": "quests/act4-hellforge#action:hephasto-victory"
              },
              "consumeActionId": {
                "const": "actions/act4-shatter-soulstone"
              },
              "sourceActionId": false
            }
          },
          {
            "required": [
              "kind",
              "sourceActionId",
              "consumeActionId"
            ],
            "properties": {
              "effect": false,
              "sourceObjectiveId": false,
              "consumedBy": false,
              "requiresAreaClear": false,
              "requiredActionSource": false,
              "recipe": false,
              "requiredTool": false,
              "ingredients": false,
              "consumeQuestId": false,
              "consumeObjectiveId": false,
              "outputItemId": false,
              "targetId": false,
              "id": {
                "const": "quest/malahs_potion"
              },
              "sourceQuestId": {
                "const": "quests/act5-prison-of-ice"
              },
              "kind": {
                "const": "action"
              },
              "sourceActionId": {
                "const": "actions/act5-receive-malah-potion"
              },
              "consumeActionId": {
                "const": "actions/act5-thaw-anya"
              }
            }
          }
        ]
      }
    }
  }
}
