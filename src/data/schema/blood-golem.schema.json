{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "d2h5://schema/blood-golem",
  "description": "Unchanged Blood Golem base stats and provisional party actual-HP-loss life leech.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "bodyStats",
    "lifeLeechFraction"
  ],
  "properties": {
    "id": {
      "const": "summons/blood-golem"
    },
    "bodyStats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manaMax",
        "defense",
        "attackSpeed",
        "critChance",
        "critDamage",
        "physDodge",
        "magicDodge",
        "magicFind",
        "goldFind",
        "resistances",
        "lifeMax",
        "attack"
      ],
      "properties": {
        "manaMax": {
          "type": "integer",
          "minimum": 0
        },
        "defense": {
          "type": "integer",
          "minimum": 0
        },
        "attackSpeed": {
          "type": "integer",
          "minimum": 0
        },
        "critChance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "critDamage": {
          "type": "number",
          "minimum": 1
        },
        "physDodge": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "magicDodge": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "magicFind": {
          "type": "number",
          "minimum": 0
        },
        "goldFind": {
          "type": "number",
          "minimum": 0
        },
        "resistances": {
          "$ref": "#/$defs/resistances"
        },
        "lifeMax": {
          "type": "integer",
          "minimum": 1
        },
        "attack": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "lifeLeechFraction": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1,
      "description": "Fraction of actual hostile HP removed restored to each living original friendly damage source; floors before missing-life cap."
    }
  },
  "$defs": {
    "resistances": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "physical",
        "fire",
        "cold",
        "lightning",
        "poison",
        "arcane"
      ],
      "properties": {
        "physical": {
          "type": "number",
          "minimum": -100,
          "maximum": 100
        },
        "fire": {
          "type": "number",
          "minimum": -100,
          "maximum": 100
        },
        "cold": {
          "type": "number",
          "minimum": -100,
          "maximum": 100
        },
        "lightning": {
          "type": "number",
          "minimum": -100,
          "maximum": 100
        },
        "poison": {
          "type": "number",
          "minimum": -100,
          "maximum": 100
        },
        "arcane": {
          "type": "number",
          "minimum": -100,
          "maximum": 100
        }
      }
    }
  }
}
