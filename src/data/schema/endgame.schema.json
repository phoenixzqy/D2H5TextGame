{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "d2h5://schema/endgame-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "nameKey", "monsterLevel", "mode", "entryCost", "lootProfile", "defaultLootTable", "waves", "modifiers", "achievement"],
  "properties": {
    "version": { "const": 1, "description": "Finite dungeon contract version." },
    "id": { "const": "endgame/worldstone-remnant" },
    "nameKey": { "$ref": "#/$defs/key" },
    "monsterLevel": { "type": "integer", "minimum": 1, "maximum": 99, "description": "Native monster level, without replay multipliers." },
    "mode": { "const": "manual" },
    "entryCost": { "type": "object", "additionalProperties": false, "description": "Free entry, preventing currency retry locks." },
    "lootProfile": {
      "type": "object", "additionalProperties": false, "required": ["act", "difficulty"],
      "properties": { "act": { "const": 5 }, "difficulty": { "const": "normal" } }
    },
    "defaultLootTable": { "type": "string", "pattern": "^loot/[a-z0-9-]+$" },
    "waves": {
      "type": "array", "minItems": 1, "maxItems": 20,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "spawns"],
        "properties": {
          "id": { "type": "string", "pattern": "^worldstone-remnant/w[1-9][0-9]*$" },
          "spawns": { "type": "array", "minItems": 1, "maxItems": 20,
            "items": { "oneOf": [
              { "type": "object", "additionalProperties": false, "required": ["kind", "archetypeId", "count", "tier"],
                "properties": { "kind": { "const": "monster" }, "archetypeId": { "$ref": "#/$defs/monsterId" },
                  "count": { "$ref": "#/$defs/count" }, "tier": { "enum": ["trash", "boss"] } } },
              { "type": "object", "additionalProperties": false, "required": ["kind", "count", "tier"],
                "properties": { "kind": { "const": "modifier" }, "count": { "$ref": "#/$defs/count" }, "tier": { "const": "trash" } } }
            ] }
          }
        }
      }
    },
    "modifiers": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": { "type": "object", "additionalProperties": false,
        "required": ["id", "nameKey", "descriptionKey", "archetypeId", "completionMaterials"],
        "properties": { "id": { "$ref": "#/$defs/modifierId" }, "nameKey": { "$ref": "#/$defs/key" },
          "descriptionKey": { "$ref": "#/$defs/key" }, "archetypeId": { "$ref": "#/$defs/monsterId" },
          "completionMaterials": { "$ref": "#/$defs/materials" } }
      }
    },
    "achievement": {
      "type": "object", "additionalProperties": false, "required": ["id", "requiredModifiers", "reward"],
      "properties": {
        "id": { "const": "achievements/worldstone-adapt" },
        "requiredModifiers": { "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true,
          "items": { "$ref": "#/$defs/modifierId" } },
        "reward": { "type": "object", "additionalProperties": false, "required": ["titleId", "materials"],
          "properties": { "titleId": { "const": "titles/worldstone-adapt" }, "materials": { "$ref": "#/$defs/materials" } } }
      }
    }
  },
  "$defs": {
    "key": { "type": "string", "pattern": "^endgame\\.[a-zA-Z0-9.]+$", "description": "Player-visible i18next key." },
    "modifierId": { "enum": ["ashen", "glacial"] },
    "monsterId": { "type": "string", "pattern": "^monsters/act5\\.[a-z0-9-]+$" },
    "count": { "type": "integer", "minimum": 1, "maximum": 20 },
    "materials": { "type": "object", "minProperties": 1,
      "patternProperties": { "^(gems|runes)/[a-z0-9/-]+$": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 } },
      "additionalProperties": false, "description": "Positive safe counts of canonical material identities." }
  }
}
