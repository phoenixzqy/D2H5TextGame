            "difficulty": {
              "const": "nightmare"
            }
          }
        },
        "act4-hell": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "act",
            "difficulty"
          ],
          "properties": {
            "act": {
              "const": 4
            },
            "difficulty": {
              "const": "hell"
            }
          }
        },
        "act5-normal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "act",
            "difficulty"
          ],
          "properties": {
            "act": {
              "const": 5
            },
            "difficulty": {
              "const": "normal"
            }
          }
        },
        "act5-nightmare": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "act",
