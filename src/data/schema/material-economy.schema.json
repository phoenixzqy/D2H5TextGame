          ],
          "properties": {
            "act": {
              "const": 3
            },
            "difficulty": {
              "const": "nightmare"
            }
          }
        },
        "act3-hell": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "act",
            "difficulty"
          ],
          "properties": {
            "act": {
              "const": 3
            },
            "difficulty": {
              "const": "hell"
            }
          }
        },
        "act4-normal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "act",
            "difficulty"
          ],
          "properties": {
            "act": {
              "const": 4
            },
            "difficulty": {
              "const": "normal"
            }
          }
        },
        "act4-nightmare": {
          "type": "object",
