{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://d2h5.game/schemas/equipment-guarantees.json",
  "title": "Additional live-kill equipment guarantees",
  "type": "array",
  "minItems": 1,
  "maxItems": 32,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["treasureClassId", "guarantees"],
    "properties": {
      "treasureClassId": { "type": "string", "pattern": "^loot/[a-z0-9-]+$", "description": "Live-kill table that receives these additional rewards." },
      "guarantees": {
        "type": "array",
        "minItems": 1,
        "maxItems": 4,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sourceTableId", "minimumRarity", "count", "chance"],
          "properties": {
            "sourceTableId": { "type": "string", "pattern": "^loot/[a-z0-9-]+$", "description": "Equipment-only source; its base weights and level gates apply." },
            "minimumRarity": { "enum": ["rare", "set"], "description": "Minimum actual materialized rarity; set accepts set or unique." },
            "count": { "type": "integer", "minimum": 1, "maximum": 3, "description": "Additional items after a successful chance roll." },
            "chance": { "type": "number", "minimum": 0, "maximum": 1, "description": "Independent probability of this bonus group." }
          }
        }
      }
    }
  }
}
