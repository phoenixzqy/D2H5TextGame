{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://d2h5.game/schemas/respec.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "freeUses",
    "paidCost",
    "currency",
    "townNpcs"
  ],
  "properties": {
    "freeUses": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10,
      "description": "Independent free uses per reset kind."
    },
    "paidCost": {
      "type": "integer",
      "minimum": 1,
      "description": "Wishstones per reset after free uses."
    },
    "currency": {
      "const": "wishstone"
    },
    "townNpcs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "1",
        "2",
        "3",
        "4",
        "5"
      ],
      "properties": {
        "1": {
          "type": "string",
          "pattern": "^npc/[a-z-]+$"
        },
        "2": {
          "type": "string",
          "pattern": "^npc/[a-z-]+$"
        },
        "3": {
          "type": "string",
          "pattern": "^npc/[a-z-]+$"
        },
        "4": {
          "type": "string",
          "pattern": "^npc/[a-z-]+$"
        },
        "5": {
          "type": "string",
          "pattern": "^npc/[a-z-]+$"
        }
      }
    }
  }
}
