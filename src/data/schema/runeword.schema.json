{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://d2h5.game/schemas/runeword.json",
  "title": "Runeword Definition",
  "description": "Runeword (orange) item definition",
  "type": "object",
  "required": [
    "id",
    "name",
    "runes",
    "allowedBases",
    "sockets",
    "reqLevel",
    "stats",
    "allowedSlots"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^runewords/[a-z0-9-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "runes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 2,
      "description": "Required rune sequence (in order)"
    },
    "allowedBases": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "weapon",
          "armor",
          "jewelry",
          "charm",
          "rune",
          "gem",
          "material"
        ]
      },
      "minItems": 1
    },
    "sockets": {
      "type": "integer",
      "minimum": 2,
      "maximum": 6
    },
    "reqLevel": {
      "type": "integer",
      "minimum": 1
    },
    "stats": {
      "$ref": "#/$defs/stats"
    },
    "grants": {
      "type": "array",
      "minItems": 1,
      "description": "Reviewed self-only adaptations, resolved from canonical equipped words at wave creation.",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "rank",
              "defensePct"
            ],
            "properties": {
              "id": {
                "const": "aura-defiance"
              },
              "rank": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              },
              "defensePct": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "rank",
              "lifePct",
              "attackSpeedPct"
            ],
            "properties": {
              "id": {
                "const": "skill-lycanthropy"
              },
              "rank": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              },
              "lifePct": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "attackSpeedPct": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "rank",
              "allResistance",
              "magicDodge"
            ],
            "properties": {
              "id": {
                "const": "skill-fade"
              },
              "rank": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              },
              "allResistance": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "magicDodge": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "rank",
              "increasedDamagePct"
            ],
            "properties": {
              "id": {
                "const": "aura-conviction"
              },
              "rank": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              },
              "increasedDamagePct": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "properties": {
                  "fire": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "cold": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "lightning": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "poison": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "arcane": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "rank",
              "increasedDamagePct"
            ],
            "properties": {
              "id": {
                "const": "aura-holy-shock"
              },
              "rank": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              },
              "increasedDamagePct": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "properties": {
                  "fire": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "cold": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "lightning": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "poison": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "arcane": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "rank",
              "reflectionPct"
            ],
            "properties": {
              "id": {
                "const": "aura-thorns-aura"
              },
              "rank": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              },
              "reflectionPct": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "rank",
              "skillId",
              "manaRegenPct"
            ],
            "properties": {
              "id": {
                "const": "aura-redemption"
              },
              "rank": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              },
              "skillId": {
                "const": "item.redemption"
              },
              "manaRegenPct": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "rank",
              "skillId",
              "increasedDamagePct"
            ],
            "properties": {
              "id": {
                "const": "skill-fire-bolt"
              },
              "rank": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              },
              "skillId": {
                "const": "sorceress.fire_bolt"
              },
              "increasedDamagePct": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "properties": {
                  "fire": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "cold": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "lightning": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "poison": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "arcane": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "rank",
              "skillId"
            ],
            "properties": {
              "id": {
                "const": "skill-blaze"
              },
              "rank": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              },
              "skillId": {
                "const": "sorceress.blaze"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "rank",
              "skillId"
            ],
            "properties": {
              "id": {
                "const": "skill-chain-lightning"
              },
              "rank": {
                "type": "integer",
                "minimum": 1,
                "maximum": 20
              },
              "skillId": {
                "const": "sorceress.chain_lightning"
              }
            }
          }
        ]
      }
    },
    "allowedSlots": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "head",
          "chest",
          "gloves",
          "belt",
          "boots",
          "amulet",
          "ring-left",
          "ring-right",
          "weapon",
          "offhand"
        ]
      },
      "description": "All allowed placement slots, subject to weapon/armor branch identity."
    },
    "allowedWeaponTypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "claw",
          "sword",
          "axe",
          "mace",
          "dagger",
          "spear",
          "polearm",
          "bow",
          "crossbow",
          "throwing",
          "staff",
          "wand",
          "scepter",
          "orb"
        ]
      },
      "description": "Restriction on weapon branches only; armor/offhand branches remain independent."
    }
  },
  "$defs": {
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "coreStats": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "strength": {
              "type": "integer"
            },
            "dexterity": {
              "type": "integer"
            },
            "vitality": {
              "type": "integer"
            },
            "energy": {
              "type": "integer"
            }
          }
        },
        "resistances": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "fire": {
              "type": "number"
            },
            "cold": {
              "type": "number"
            },
            "lightning": {
              "type": "number"
            },
            "poison": {
              "type": "number"
            },
            "arcane": {
              "type": "number"
            },
            "physical": {
              "type": "number"
            },
            "all": {
              "type": "number",
              "description": "Additive points in all six resistances."
            }
          }
        },
        "statMods": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "life": {
              "type": "number"
            },
            "mana": {
              "type": "number"
            },
            "attack": {
              "type": "number"
            },
            "defense": {
              "type": "number"
            },
            "attackSpeed": {
              "type": "number"
            },
            "critChance": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Ratio; ordinary modern affix rolls retain their separate point authoring."
            },
            "critDamage": {
              "type": "number"
            },
            "physDodge": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Ratio; ordinary modern affix rolls retain their separate point authoring."
            },
            "magicDodge": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Ratio; ordinary modern affix rolls retain their separate point authoring."
            },
            "magicFind": {
              "type": "number"
            },
            "goldFind": {
              "type": "number"
            },
            "magicResist": {
              "type": "number",
              "minimum": 0,
              "description": "Flat magical mitigation, not resistance percentage points."
            }
          }
        },
        "grantsSkills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
