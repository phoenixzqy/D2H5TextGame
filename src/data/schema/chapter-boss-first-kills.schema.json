{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://d2h5.game/schemas/chapter-boss-first-kills.json",
  "title": "Chapter-boss first-kill rewards",
  "type": "object",
  "additionalProperties": false,
  "required": ["eliteBaseIds", "bosses"],
  "properties": {
    "eliteBaseIds": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "description": "Explicit Elite base catalog from items-spec section 3; never inferred from equip level.",
      "items": { "type": "string", "pattern": "^items/base/[a-z0-9-]+$" }
    },
    "bosses": {
      "type": "array", "minItems": 5, "maxItems": 5,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["treasureClassId", "act", "areaId", "bossId", "randomUnique"],
        "properties": {
          "treasureClassId": { "type": "string", "pattern": "^loot/[a-z0-9-]+$", "description": "Live chapter-boss reward source." },
          "act": { "type": "integer", "minimum": 1, "maximum": 5, "description": "Required actual act." },
          "areaId": { "type": "string", "pattern": "^areas/act[1-5]-[a-z0-9-]+$", "description": "Persisted difficulty-specific first-clear identity." },
          "bossId": { "type": "string", "pattern": "^monsters/act[1-5]\\.[a-z0-9-]+$", "description": "Required original recorded boss archetype." },
          "randomUnique": { "enum": ["any", "armor-or-weapon", "elite"], "description": "Additional restriction on the eligible weighted unique sources." },
          "namedUnique": {
            "type": "object", "additionalProperties": false, "required": ["id", "chance"],
            "description": "Exact named alternative, excluded from the random branch.",
            "properties": {
              "id": { "type": "string", "pattern": "^items/unique/[a-z0-9-]+$" },
              "chance": { "type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1 }
            }
          },
          "hellRune": {
            "type": "object", "additionalProperties": false, "required": ["minimum", "maximum"],
            "description": "One additional Hell-only rune in inclusive canonical ordinal band.",
            "properties": {
              "minimum": { "type": "integer", "minimum": 23, "maximum": 33 },
              "maximum": { "type": "integer", "minimum": 23, "maximum": 33 }
            }
          }
        }
      }
    }
  }
}
