{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://d2h5.game/schemas/skill.json",
  "title": "Skill Definition",
  "description": "Skill template definition",
  "type": "object",
  "required": ["id", "name", "description", "trigger", "target", "cooldown", "minLevel", "maxLevel"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$",
      "description": "Unique skill ID"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "tree": {
      "type": "string",
      "description": "Skill tree name (e.g., 'Cold', 'Combat Masteries', 'Curses')"
    },
    "requiredLevel": {
      "type": "integer",
      "minimum": 1,
      "description": "Character level required to unlock this skill"
    },
    "prerequisites": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Array of skill IDs that must be learned first"
    },
    "passive": {
      "type": "boolean",
      "description": "True if this is a passive skill with always-on effect"
    },
    "aura": {
      "type": "boolean",
      "description": "True if this is a toggled aura skill (Paladin)"
    },
    "summon": {
      "type": "boolean",
      "description": "True if this skill summons a creature"
    },
    "summonId": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "description": "Registered summon template id spawned by this skill"
    },
    "icon": {
      "type": "string",
      "description": "Icon asset path"
    },
    "trigger": {
      "type": "string",
      "enum": ["active", "passive", "on-hit", "on-kill", "on-damaged", "on-dodge"]
    },
    "target": {
      "type": "string",
      "enum": ["self", "single-enemy", "all-enemies", "area-enemies", "single-ally", "all-allies", "summon"]
    },
    "aoeShape": {
      "type": "string",
      "enum": ["single", "line-3", "column-3", "cross", "box-3x3", "all-enemies"],
      "description": "Optional AOE shape on the 3-column battle grid. Does not imply attack range or movement."
    },
    "cooldown": {
      "type": "number",
      "minimum": 0,
      "description": "Cooldown in turns"
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mana": { "type": "number", "minimum": 0 },
        "life": { "type": "number", "minimum": 0 }
      }
    },
    "damage": {
      "$ref": "#/$defs/damageInfo"
    },
    "damageType": {
      "$ref": "#/$defs/damageType"
    },
    "appliesStatus": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Status effect IDs applied"
    },
    "statusEffect": {
      "type": "object",
      "additionalProperties": false,
      "description": "Runtime metadata for the first appliesStatus id, such as DoT strength or stack count.",
      "properties": {
        "chance": { "type": "number", "minimum": 0, "maximum": 1 },
        "stacksOnApply": { "type": "integer", "minimum": 1 },
        "dotPctOfDamage": { "type": "number", "minimum": 0 }
      }
    },
    "heal": {
      "type": "object",
      "required": ["min", "max", "target"],
      "additionalProperties": false,
      "properties": {
        "min": { "type": "number", "minimum": 0 },
        "max": { "type": "number", "minimum": 0 },
        "target": {
          "type": "string",
          "enum": ["self", "ally"]
        }
      }
    },
    "appliesTags": {
      "type": "array",
      "items": { "$ref": "#/$defs/comboTag" }
    },
    "synergies": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^(cold|fire|lightning|poison|physical|arcane|chill|burn|shock|bleed|amp-damage)$": {
          "type": "number",
          "minimum": 1,
          "description": "Damage multiplier for this combo tag"
        }
      }
    },
    "minLevel": {
      "type": "integer",
      "minimum": 1
    },
    "maxLevel": {
      "type": "integer",
      "minimum": 1
    },
    "scaling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "damagePerLevel": { "type": "number" },
        "cooldownPerLevel": { "type": "number" },
        "costPerLevel": { "type": "number" },
        "summonMaxCount": {
          "type": "object",
          "required": ["kind"],
          "additionalProperties": false,
          "properties": {
            "kind": {
              "type": "string",
              "enum": ["first-three-then-every-three", "raise-skeleton-1-6-12-cap-3"]
            }
          }
        },
        "summonStatsPerLevel": {
          "type": "object",
          "additionalProperties": false,
          "description": "Flat per-skill-rank growth applied to the summoned unit template at runtime and in skill previews.",
          "properties": {
            "lifeMax": { "type": "number" },
            "attack": { "type": "number" },
            "defense": { "type": "number" },
            "attackSpeed": { "type": "number" },
            "physDodge": { "type": "number" },
            "magicDodge": { "type": "number" }
          }
        },
        "passiveStatsPerLevel": {
          "type": "object",
          "additionalProperties": false,
          "description": "Visible per-rank passive/utility growth for non-damage skill previews. Runtime hooks may consume these as systems mature.",
          "properties": {
            "summonLifePct": { "type": "number" },
            "summonAttackPct": { "type": "number" },
            "summonDefensePct": { "type": "number" },
            "summonResistAllPct": { "type": "number" },
            "fireDamagePct": { "type": "number" },
            "coldDamagePct": { "type": "number" },
            "lightningDamagePct": { "type": "number" },
            "poisonDamagePct": { "type": "number" },
            "arcaneDamagePct": { "type": "number" },
            "physicalDamagePct": { "type": "number" },
            "elementalDamagePct": { "type": "number" },
            "attackPct": { "type": "number" },
            "attackSpeedPct": { "type": "number" },
            "critChancePct": { "type": "number" },
            "lifePct": { "type": "number" },
            "lifeRegenPct": { "type": "number" },
            "resistAllPct": { "type": "number" },
            "thornsPct": { "type": "number" },
            "defensePct": { "type": "number" },
            "physDodgePct": { "type": "number" },
            "magicDodgePct": { "type": "number" },
            "manaRegenPct": { "type": "number" },
            "magicFindPct": { "type": "number" },
            "shieldAbsorbPct": { "type": "number" },
            "boneArmorAbsorb": { "type": "number" },
            "golemLifePct": { "type": "number" },
            "golemAttackSpeed": { "type": "number" }
          }
        }
      }
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "description": "Equipment gate. The currently equipped weapon must satisfy each provided whitelist for the skill to be usable.",
      "properties": {
        "weaponType": {
          "type": "array",
          "items": { "$ref": "#/$defs/weaponType" },
          "minItems": 1
        },
        "handedness": {
          "type": "array",
          "items": { "$ref": "#/$defs/handedness" },
          "minItems": 1
        }
      }
    }
  },
  "$defs": {
    "weaponType": {
      "type": "string",
      "enum": [
        "sword", "axe", "mace", "dagger", "spear", "polearm",
        "bow", "crossbow", "throwing",
        "staff", "wand", "scepter", "orb"
      ]
    },
    "handedness": {
      "type": "string",
      "enum": ["oneHanded", "twoHanded"]
    },
    "damageType": {
      "type": "string",
      "enum": ["physical", "fire", "cold", "lightning", "arcane", "poison", "thorns"]
    },
    "comboTag": {
      "type": "string",
      "enum": ["cold", "fire", "lightning", "poison", "physical", "arcane", "chill", "burn", "shock", "bleed", "amp-damage"]
    },
    "damageInfo": {
      "type": "object",
      "required": ["min", "max", "breakdown"],
      "additionalProperties": false,
      "properties": {
        "min": { "type": "number", "minimum": 0 },
        "max": { "type": "number", "minimum": 0 },
        "breakdown": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "physical": { "type": "number", "minimum": 0 },
            "fire": { "type": "number", "minimum": 0 },
            "cold": { "type": "number", "minimum": 0 },
            "lightning": { "type": "number", "minimum": 0 },
            "arcane": { "type": "number", "minimum": 0 },
            "poison": { "type": "number", "minimum": 0 },
            "thorns": { "type": "number", "minimum": 0 }
          }
        }
      }
    }
  }
}
