{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://d2h5.game/schemas/quest.json",
  "title": "Quest Document",
  "type": "object",
  "description": "Bundled quest document validated before the central loader collects entries.",
  "required": [
    "quests"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1,
      "description": "Optional authoring schema reference."
    },
    "quests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/quest"
      },
      "description": "Complete main or side quest document."
    }
  },
  "$defs": {
    "areaId": {
      "type": "string",
      "pattern": "^areas/[a-z0-9][a-z0-9._-]*$",
      "description": "Area identifier; existence is a separate content contract."
    },
    "itemId": {
      "type": "string",
      "pattern": "^(quest|items)/[a-z0-9][a-z0-9._-]*$",
      "description": "Quest or inventory item identifier."
    },
    "npcId": {
      "type": "string",
      "pattern": "^npc/[a-z0-9][a-z0-9._-]*$",
      "description": "Canonical NPC identifier."
    },
    "monsterId": {
      "type": "string",
      "pattern": "^monsters/[a-z0-9][a-z0-9._-]*$",
      "description": "Monster identifier; existence is a separate content contract."
    },
    "objectId": {
      "type": "string",
      "pattern": "^objects/[a-z0-9][a-z0-9._-]*$",
      "description": "Interactable object identifier."
    },
    "mercId": {
      "type": "string",
      "pattern": "^mercs/[a-z0-9][a-z0-9._-]*$",
      "description": "Mercenary identifier."
    },
    "questId": {
      "type": "string",
      "pattern": "^quests/[a-z0-9][a-z0-9._-]*$",
      "description": "Quest identifier."
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1,
      "description": "Positive count, wave count or authored ordering index."
    },
    "nonnegativeInteger": {
      "type": "integer",
      "minimum": 0,
      "description": "Nonnegative reward amount; zero is authored and valid."
    },
    "itemFilter": {
      "type": "string",
      "enum": [
        "normal",
        "any"
      ],
      "description": "Accepted delivery item category."
    },
    "recipe": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "description": "Authored recipe token (not a namespaced item ID)."
    },
    "objective": {
      "description": "Closed objective payload selected by its authored type; each selected payload retains its complete validation.",
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "clear-area",
            "collect",
            "deliver",
            "fetch",
            "gamble",
            "hire-mercenary",
            "interact",
            "kill",
            "kill-boss",
            "kill-boss-group",
            "rescue",
            "survive-waves",
            "talk",
            "transmute",
            "use-item",
            "give"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "clear-area"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/clearAreaObjective"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "collect"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/collectObjective"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "deliver"
              }
            }
          },
          "then": {
            "oneOf": [
              {
                "$ref": "#/$defs/deliverFilteredObjective"
              },
              {
                "$ref": "#/$defs/deliverCountedObjective"
              }
            ]
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "fetch"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/fetchObjective"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "gamble"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/gambleObjective"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "hire-mercenary"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/hireMercenaryObjective"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "interact"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/interactObjective"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "kill"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/killObjective"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "kill-boss"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/killBossObjective"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "kill-boss-group"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/killBossGroupObjective"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "rescue"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/rescueObjective"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "survive-waves"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/surviveWavesObjective"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "talk"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/talkObjective"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "transmute"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/transmuteObjective"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "use-item"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/useItemObjective"
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "give"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/giveObjective"
          }
        }
      ]
    },
    "clearAreaObjective": {
      "type": "object",
      "description": "clear-area objective payload.",
      "required": [
        "id",
        "type",
        "description",
        "areaId"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Objective identifier, scoped to its quest."
        },
        "type": {
          "const": "clear-area"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Authored objective description."
        },
        "areaId": {
          "$ref": "#/$defs/areaId"
        },
        "count": {
          "const": 1,
          "description": "One complete area clear; accepted bounty runs supply its authority."
        }
      }
    },
    "collectObjective": {
      "type": "object",
      "description": "collect objective payload.",
      "required": [
        "id",
        "type",
        "description",
        "itemId",
        "count",
        "areaId"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Objective identifier, scoped to its quest."
        },
        "type": {
          "const": "collect"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Authored objective description."
        },
        "itemId": {
          "$ref": "#/$defs/itemId"
        },
        "count": {
          "$ref": "#/$defs/positiveInteger"
        },
        "areaId": {
          "$ref": "#/$defs/areaId"
        }
      }
    },
    "deliverFilteredObjective": {
      "type": "object",
      "description": "deliver objective payload.",
      "required": [
        "id",
        "type",
        "description",
        "npcId",
        "itemFilter"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Objective identifier, scoped to its quest."
        },
        "type": {
          "const": "deliver"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Authored objective description."
        },
        "npcId": {
          "$ref": "#/$defs/npcId"
        },
        "itemFilter": {
          "$ref": "#/$defs/itemFilter"
        }
      }
    },
    "deliverCountedObjective": {
      "type": "object",
      "description": "deliver objective payload.",
      "required": [
        "id",
        "type",
        "description",
        "npcId",
        "itemId",
        "count"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Objective identifier, scoped to its quest."
        },
        "type": {
          "const": "deliver"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Authored objective description."
        },
        "npcId": {
          "$ref": "#/$defs/npcId"
        },
        "itemId": {
          "$ref": "#/$defs/itemId"
        },
        "count": {
          "$ref": "#/$defs/positiveInteger"
        },
        "areaId": {
          "$ref": "#/$defs/areaId",
          "description": "Optional canonical area where the counted delivery ingredients are recovered; the delivery NPC remains separate."
        }
      }
    },
    "fetchObjective": {
      "type": "object",
      "description": "fetch objective payload.",
      "required": [
        "id",
        "type",
        "description",
        "itemId",
        "areaId"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Objective identifier, scoped to its quest."
        },
        "type": {
          "const": "fetch"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Authored objective description."
        },
        "itemId": {
          "$ref": "#/$defs/itemId"
        },
        "areaId": {
          "$ref": "#/$defs/areaId"
        },
        "targetId": {
          "$ref": "#/$defs/objectId",
          "description": "Explicit object source for an objective-bound tool; omitted legacy fetches remain unsupported by recovery."
        }
      }
    },
    "gambleObjective": {
      "type": "object",
      "description": "gamble objective payload.",
      "required": [
        "id",
        "type",
        "description",
        "count"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Objective identifier, scoped to its quest."
        },
        "type": {
          "const": "gamble"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Authored objective description."
        },
        "count": {
          "$ref": "#/$defs/positiveInteger"
        }
      }
    },
    "hireMercenaryObjective": {
      "type": "object",
      "description": "hire-mercenary objective payload.",
      "required": [
        "id",
        "type",
        "description",
        "mercId"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Objective identifier, scoped to its quest."
        },
        "type": {
          "const": "hire-mercenary"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Authored objective description."
        },
        "mercId": {
          "$ref": "#/$defs/mercId"
        }
      }
    },
    "interactObjective": {
      "description": "Interaction at an area, using a required item, or both. Each closed variant is explicit for strict Ajv validation.",
      "oneOf": [
        {
          "$ref": "#/$defs/interactAreaObjective"
        },
        {
          "$ref": "#/$defs/interactItemObjective"
        },
        {
          "$ref": "#/$defs/interactAreaAndItemObjective"
        }
      ]
    },
    "killObjective": {
      "type": "object",
      "description": "kill objective payload.",
      "required": [
        "id",
        "type",
        "description",
        "targetId",
        "areaId"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Objective identifier, scoped to its quest."
        },
        "type": {
          "const": "kill"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Authored objective description."
        },
        "targetId": {
          "$ref": "#/$defs/monsterId"
        },
        "areaId": {
          "$ref": "#/$defs/areaId"
        },
        "count": {
          "$ref": "#/$defs/positiveInteger"
        }
      }
    },
    "killBossObjective": {
      "type": "object",
      "description": "kill-boss objective payload.",
      "required": [
        "id",
        "type",
        "description",
        "targetId",
        "areaId"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Objective identifier, scoped to its quest."
        },
        "type": {
          "const": "kill-boss"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Authored objective description."
        },
        "targetId": {
          "$ref": "#/$defs/monsterId"
        },
        "areaId": {
          "$ref": "#/$defs/areaId"
        }
      }
    },
    "killBossGroupObjective": {
      "type": "object",
      "description": "kill-boss-group objective payload.",
      "required": [
        "id",
        "type",
        "description",
        "targetId",
        "areaId"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Objective identifier, scoped to its quest."
        },
        "type": {
          "const": "kill-boss-group"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Authored objective description."
        },
        "targetId": {
          "$ref": "#/$defs/monsterId"
        },
        "areaId": {
          "$ref": "#/$defs/areaId"
        }
      }
    },
    "rescueObjective": {
      "type": "object",
      "description": "rescue objective payload.",
      "required": [
        "id",
        "type",
        "description",
        "targetId",
        "count",
        "areaId"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Objective identifier, scoped to its quest."
        },
        "type": {
          "const": "rescue"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Authored objective description."
        },
        "targetId": {
          "$ref": "#/$defs/npcId"
        },
        "count": {
          "$ref": "#/$defs/positiveInteger"
        },
        "areaId": {
          "$ref": "#/$defs/areaId"
        }
      }
    },
    "surviveWavesObjective": {
      "type": "object",
      "description": "survive-waves objective payload.",
      "required": [
        "id",
        "type",
        "description",
        "areaId",
        "waves"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Objective identifier, scoped to its quest."
        },
        "type": {
          "const": "survive-waves"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Authored objective description."
        },
        "areaId": {
          "$ref": "#/$defs/areaId"
        },
        "waves": {
          "$ref": "#/$defs/positiveInteger"
        }
      }
    },
    "talkObjective": {
      "type": "object",
      "description": "talk objective payload.",
      "required": [
        "id",
        "type",
        "description",
        "npcId"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Objective identifier, scoped to its quest."
        },
        "type": {
          "const": "talk"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Authored objective description."
        },
        "npcId": {
          "$ref": "#/$defs/npcId"
        }
      }
    },
    "transmuteObjective": {
      "type": "object",
      "description": "transmute objective payload.",
      "required": [
        "id",
        "type",
        "description",
        "recipe"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Objective identifier, scoped to its quest."
        },
        "type": {
          "const": "transmute"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Authored objective description."
        },
        "recipe": {
          "$ref": "#/$defs/recipe"
        }
      }
    },
    "useItemObjective": {
      "type": "object",
      "description": "use-item objective payload.",
      "required": [
        "id",
        "type",
        "description",
        "itemId"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "description": "Objective identifier, scoped to its quest."
        },
        "type": {
          "const": "use-item"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Authored objective description."
        },
        "itemId": {
          "$ref": "#/$defs/itemId"
        }
      }
    },
    "statReward": {
      "description": "Authored permanent stat reward fields; delivery is a separate gameplay contract.",
      "oneOf": [
        {
          "type": "object",
          "description": "Authored permanent stat reward fields; delivery is a separate gameplay contract.",
          "required": [],
          "additionalProperties": false,
          "properties": {
            "life": {
              "$ref": "#/$defs/nonnegativeInteger"
            },
            "attribute_points": {
              "$ref": "#/$defs/nonnegativeInteger"
            },
            "all_resist": {
              "$ref": "#/$defs/nonnegativeInteger"
            },
            "vitality": {
              "$ref": "#/$defs/nonnegativeInteger"
            }
          }
        },
        {
          "type": "object",
          "description": "Permanent hero fire/cold resistance pair in percentage points.",
          "required": [
            "fire_resist",
            "cold_resist"
          ],
          "additionalProperties": false,
          "properties": {
            "fire_resist": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Permanent resistance percentage points."
            },
            "cold_resist": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Permanent resistance percentage points."
            }
          }
        }
      ]
    },
    "rewards": {
      "type": "object",
      "description": "Supported authored and declared reward shapes; acceptance does not promise delivery.",
      "required": [],
      "additionalProperties": false,
      "properties": {
        "xp": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "gold": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "skillPoints": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "questItem": {
          "$ref": "#/$defs/itemId",
          "description": "One bound quest-item entitlement; canonical definition/source pairing is checked separately."
        },
        "statPoints": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "runes": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "runeShards": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "gems": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "wishstones": {
          "$ref": "#/$defs/nonnegativeInteger"
        },
        "stat": {
          "$ref": "#/$defs/statReward"
        },
        "itemDrop": {
          "description": "Legacy identifier, exact unique reward, or closed versioned unique profile; delivery and eligibility are separate.",
          "oneOf": [
            {
              "type": "string",
              "pattern": "^(?:items/[a-z0-9][a-z0-9._-]*|items/base/[a-z0-9-]+|items/unique/[a-z0-9-]+)$",
              "description": "Legacy flat or canonical base/unique item reward identifier; syntax only, template resolution is separate."
            },
            {
              "type": "object",
              "description": "One named unique item at an authored positive item level.",
              "required": [
                "uniqueId",
                "ilvl"
              ],
              "additionalProperties": false,
              "properties": {
                "uniqueId": {
                  "type": "string",
                  "pattern": "^items/unique/[a-z0-9-]+$",
                  "description": "Exact canonical unique template identifier."
                },
                "ilvl": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "Authored item generation level; no campaign cap."
                }
              }
            },
            {
              "type": "object",
              "description": "One ring from the closed Gidbinn v1 profile at its fixed item level.",
              "required": [
                "profileId"
              ],
              "additionalProperties": false,
              "properties": {
                "profileId": {
                  "const": "quest-rewards/act3-gidbinn-ring-v1"
                }
              }
            }
          ]
        },
        "lootTable": {
          "description": "Legacy table identifier or explicit quest cache parameters; legacy strings remain unsupported by reward execution.",
          "oneOf": [
            {
              "type": "string",
              "pattern": "^loot/[a-z0-9][a-z0-9._-]*$"
            },
            {
              "type": "object",
              "description": "Quest cache with authored generation level and independent pick count.",
              "required": [
                "tableId",
                "ilvl",
                "picks"
              ],
              "additionalProperties": false,
              "properties": {
                "tableId": {
                  "type": "string",
                  "pattern": "^loot/[a-z0-9][a-z0-9._-]*$",
                  "description": "Treasure-class identifier; existence is checked at reward execution."
                },
                "ilvl": {
                  "$ref": "#/$defs/positiveInteger",
                  "description": "Authored item generation level."
                },
                "picks": {
                  "$ref": "#/$defs/positiveInteger",
                  "description": "Number of independent treasure-class picks."
                }
              }
            }
          ]
        },
        "mercenaryUnlock": {
          "$ref": "#/$defs/mercId"
        },
        "npcUnlock": {
          "$ref": "#/$defs/npcId"
        },
        "service": {
          "type": "string",
          "enum": [
            "identify_free",
            "imbue_item",
            "socket_item",
            "personalize_item",
            "repair_discount",
            "socket_armor"
          ],
          "description": "Currently authored service reward token."
        },
        "areaUnlock": {
          "$ref": "#/$defs/areaId"
        },
        "vendorUnlock": {
          "type": "string",
          "pattern": "^vendors/[a-z0-9][a-z0-9._-]*$",
          "description": "Vendor identifier."
        },
        "title": {
          "type": "string",
          "pattern": "^titles/[a-z0-9][a-z0-9._-]*$",
          "description": "Title identifier."
        },
        "gemShards": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991,
          "description": "Generic gem-shard currency granted at Claim."
        }
      }
    },
    "quest": {
      "type": "object",
      "description": "A structurally valid quest. Cross-reference and gameplay execution contracts remain separate.",
      "required": [
        "id",
        "name",
        "type",
        "actId",
        "description",
        "objectives"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/questId"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Existing authored quest name; localization remains a separate consumer concern."
        },
        "type": {
          "type": "string",
          "enum": [
            "main",
            "side",
            "bounty"
          ],
          "description": "Quest family."
        },
        "actId": {
          "type": "string",
          "pattern": "^acts/act[1-5]$",
          "description": "Owning campaign act."
        },
        "giver": {
          "type": "string",
          "pattern": "^(npc|objects)/[a-z0-9][a-z0-9._-]*$",
          "description": "NPC or object that offers the quest."
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "Existing authored quest description."
        },
        "objectives": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/objective"
          },
          "description": "Ordered objective payloads, with IDs scoped per quest."
        },
        "objectiveStages": {
          "type": "array",
          "minItems": 1,
          "description": "Complete ordered partition of objective IDs; each stage is unordered internally. Omission retains serial objective order. Coverage and cross-stage duplicates are checked by the loader.",
          "items": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "rewards": {
          "$ref": "#/$defs/rewards"
        },
        "unlocks": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(areas|services|acts|difficulty)/[a-z0-9][a-z0-9._-]*$",
          "description": "Optional authored progression reference; null means none."
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/questId"
          },
          "description": "Prerequisite quest identifiers; resolution/cycles are separate content checks."
        },
        "order": {
          "$ref": "#/$defs/positiveInteger"
        }
      }
    },
